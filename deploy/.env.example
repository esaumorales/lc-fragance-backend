# Copiar como .env en el servidor. Nunca se sube al repositorio.

# Imagen publicada por CI
BACKEND_IMAGE=ghcr.io/USUARIO/lc-fragance-backend:latest

# Dominios
API_DOMAIN=api.tudominio.com
CLIENT_URL=https://tudominio.com

# Base de datos (la contraseña se genera, no se inventa)
POSTGRES_USER=lcfragance
POSTGRES_PASSWORD=
POSTGRES_DB=lcfragance

# Secretos JWT: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin inicial que crea el seed
ADMIN_EMAIL=
ADMIN_PASSWORD=
