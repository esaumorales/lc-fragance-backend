# Copiar como .env en el servidor. Nunca se sube al repositorio.

# Imagen publicada por CI
BACKEND_IMAGE=ghcr.io/USUARIO/lc-fragance-backend:latest

# Dominios
API_DOMAIN=api.tudominio.com
CLIENT_URL=https://tudominio.com

# Base de datos (la contraseña se genera, no se inventa)
POSTGRES_USER=lcfragance
POSTGRES_PASSWORD=
POSTGRES_DB=lcfragance

# Secretos JWT: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin inicial que crea el seed. ADMIN_PASSWORD es obligatoria: sin ella el
# seed corta en produccion en vez de crear un admin con clave conocida.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Correo (Resend). Sin esto, el codigo del segundo factor no se envia y queda
# escrito en el log del contenedor para no quedar encerrado fuera del panel.
# Sin dominio propio verificado, Resend solo entrega a tu propia direccion.
RESEND_API_KEY=
EMAIL_FROM=LC Fragance <onboarding@resend.dev>
