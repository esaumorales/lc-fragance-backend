# App
NODE_ENV=development
PORT=4001
CLIENT_URL=http://localhost:3000

# Database (coincide con docker-compose.yml) - puerto 5434 porque 5432 lo usa
# otro proyecto (presusoft_postgres)
DATABASE_URL=postgresql://fragance:fragance_dev_password@localhost:5434/fragance?schema=public

# JWT
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend (emails)
RESEND_API_KEY=
EMAIL_FROM="Lyon Call <no-reply@lyoncall.com>"

# Checkout sin pasarela de pago (WhatsApp / Yape)
WHATSAPP_PHONE=51999999999
YAPE_PHONE=999999999
YAPE_NAME="Lyon Call"

# Cuenta admin creada por el seed (cambiar antes de producción)
ADMIN_EMAIL=admin@lyoncall.com
ADMIN_PASSWORD=change_me_admin_password
