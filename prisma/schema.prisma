generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  // El dueño: es el unico que da de alta y de baja administradores.
  SUPERADMIN
}

// Para que sirve un enlace de un solo uso enviado por correo.
enum LinkPurpose {
  INVITE
  RESET
}

// Para que sirve un codigo: entrar, o confirmar una accion delicada ya dentro.
enum CodePurpose {
  LOGIN
  ACTION
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(CUSTOMER)
  // Suspender conserva el historial; eliminar lo borra. Un suspendido no entra.
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens     RefreshToken[]
  cart              Cart?
  orders            Order[]
  verificationCodes VerificationCode[]
  accessLinks       AccessLink[]
  address           Address?
}

// Una direccion por cuenta: el envio se coordina por WhatsApp, asi que el
// telefono y la referencia importan tanto como la calle.
model Address {
  id         String   @id @default(uuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipient  String?
  phone      String?
  street     String
  reference  String?
  district   String
  city       String
  region     String?
  postalCode String?
  // Punto exacto en el mapa. Opcional: la direccion escrita alcanza para
  // enviar, esto solo ayuda a encontrarla.
  latitude   Float?
  longitude  Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Segundo factor: el codigo que llega al correo al iniciar sesion como admin.
model VerificationCode {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Un codigo de accion no sirve para entrar ni al reves.
  purpose   CodePurpose @default(LOGIN)
  // Se guarda el hash, igual que los refresh: si se filtra la tabla no sirve.
  codeHash  String
  attempts  Int         @default(0)
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime    @default(now())

  @@index([userId])
}

// Enlace de un solo uso para poner contraseña: invitacion o restablecimiento.
model AccessLink {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String      @unique
  purpose   LinkPurpose
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime    @default(now())

  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  revokedAt DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Category {
  id       String     @id @default(uuid())
  name     String
  slug     String     @unique
  parentId String?
  parent   Category?  @relation("CategoryToSubcategory", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToSubcategory")

  products Product[]
}

// Modelo genérico: los campos comunes viven en columnas, lo específico
// de cada rubro (perfumes, tecnología, ...) vive en `attributes` (JSON).
model Product {
  id            String    @id @default(uuid())
  name          String
  slug          String    @unique
  description   String
  price         Decimal   @db.Decimal(10, 2)
  // Oferta: precio rebajado y desde cuando hasta cuando rige. Las fechas son
  // opcionales por separado; sin ellas la oferta no vence sola.
  offerPrice    Decimal?  @db.Decimal(10, 2)
  offerStartsAt DateTime?
  offerEndsAt   DateTime?
  sku           String    @unique
  stock         Int       @default(0)
  images        String[] // URLs de Cloudinary
  model3dUrl    String? // URL Cloudinary del .glb/.gltf, opcional
  attributes    Json      @default("{}") // ej. perfumes: { mlVolume, notasOlfativas }; tech: { ram, almacenamiento }
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  cartItems     CartItem[]
  orderItems    OrderItem[]
  inventoryLogs InventoryLog[]

  // Indices para el catalogo: el listado siempre filtra por isActive y ordena
  // por createdAt, y los filtros nuevos pegan sobre categoria y precio.
  @@index([isActive, createdAt])
  @@index([categoryId])
  @@index([price])
}

model Cart {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String  @id @default(uuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int

  @@unique([cartId, productId])
}

model Order {
  id String @id @default(uuid())

  // Opcional: tambien compra quien no quiso crearse una cuenta. Los datos de
  // contacto van igual en el pedido, con cuenta o sin ella, porque son los de
  // esta compra y no los del perfil, que puede cambiar despues.
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  nombre  String
  correo  String
  celular String

  status OrderStatus @default(PENDING)
  total  Decimal     @db.Decimal(10, 2)

  entrega    TipoDeEntrega @default(RECOJO)
  direccion  String?
  costoEnvio Decimal       @default(0) @db.Decimal(10, 2)
  nota       String?

  metodoPago MetodoDePago
  // URL del comprobante en Cloudinary. Lo mira el admin antes de aceptar.
  voucherUrl String?

  // Lo que el admin promete al aceptar: "entre 2 y 3 dias". Texto libre
  // porque el plazo real depende del pedido y de la agenda de la tienda.
  plazo      String?
  aceptadoEn DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]
}

enum TipoDeEntrega {
  RECOJO
  DELIVERY
}

enum MetodoDePago {
  YAPE
  TRANSFERENCIA
}

// Los datos de cobro de la tienda. Hay una sola fila: no son de cada admin,
// son del negocio, y cualquier admin la edita.
model ConfiguracionDePago {
  id String @id @default("unica")

  titular String?
  yape    String?
  banco   String?
  cuenta  String?
  cci     String?

  // A donde llega el aviso de cada pedido nuevo. Una sola casilla.
  correoDeAvisos String?

  recojoActivo   Boolean @default(true)
  deliveryActivo Boolean @default(true)
  costoDelivery  Decimal @default(0) @db.Decimal(10, 2)

  updatedAt DateTime @updatedAt
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
}

// Trazabilidad de cambios de stock (para el stock en tiempo real vía Socket.IO)
model InventoryLog {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  change    Int // positivo = entrada, negativo = salida
  reason    String // "order", "restock", "manual_adjustment"
  createdAt DateTime @default(now())

  @@index([productId])
}
